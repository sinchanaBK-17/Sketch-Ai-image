# Copy this file to ".env" and fill in what you have. Every key is OPTIONAL.
# With no keys at all the app still runs in DEMO mode (local OpenCV rendering).

# Easiest: paste the key in the app (top "API key" box) - it saves here for you.
# Or set it by hand. Get a free key: https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# Sketch -> prompt using Claude vision (optional, improves prompts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# auto = Stability if key present, otherwise demo
IMAGE_PROVIDER=auto
PORT=5000
